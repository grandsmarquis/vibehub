# Option A — split vars (host/port only in DATABASE_URL; credentials separate)
DATABASE_URL=postgres://your-db-host.example:5432/
DATABASE_USERNAME=vibehub_admin
DATABASE_PASSWORD=your-password
DATABASE_NAME=vibehub

# Remote / managed Postgres often needs TLS (set to true if connection fails without it)
DATABASE_SSL=true
# If the server uses a self-signed cert, set to false (less secure)
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Option B — single URL (omit USERNAME/PASSWORD/NAME above if you use this)
# DATABASE_URL=postgresql://user:password@host:5432/vibehub

AUTH_SECRET=generate-with-openssl-rand-base64-32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional; defaults to current origin
AUTH_URL=http://localhost:3000
